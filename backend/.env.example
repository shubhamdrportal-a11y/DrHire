# ── Database ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drhire
DB_USER=root
DB_PASS=

# ── Application ───────────────────────────────────────────────────
# Full public URL (no trailing slash)
APP_URL=https://your-app.up.railway.app
# Long random secret string — used for CSRF and other signatures
APP_SECRET=change-me-to-a-long-random-string

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://your-app.up.railway.app

# ── Session ───────────────────────────────────────────────────────
SESSION_SECURE=true        # Set to false for local HTTP dev
SESSION_SAMESITE=Lax       # Lax or Strict
SESSION_LIFETIME=86400     # 24 hours in seconds

# ── Railway Bucket / S3-compatible Storage ────────────────────────
# Leave blank to use local file storage (dev only, NOT for production)
S3_ENDPOINT=https://your-bucket-endpoint
S3_BUCKET=drhire-files
S3_KEY=your-access-key-id
S3_SECRET=your-secret-access-key
S3_REGION=us-east-1
